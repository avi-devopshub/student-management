pipeline{
	agent{
		label 'worker'
	}
	tools{
		maven 'maven'
	}
	environment{
		aws_creds = credentials('aws_creds')
	}
	stages{
		stage('checkout'){
			steps{
				git 'https://github.com/avi-devopshub/student-management.git'
			}
			post{
				success{
					echo "checkout has been completed"
				}
			}
		}
		stage('mvn-build'){
			steps{
				
				sh '''
				   java --version
				   mvn --version
				   mvn clean package
				   '''
			}
			post{
				success{
					archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
				}
			}
		}
		stage('artifact to s3'){
			steps{
			sh 'aws s3 cp target/*.war s3://artifactory-554663574879-ap-south-2-an/artifacts/student.war'
			}
		}
        stage('Upload Artifact to Nexus') {
            steps {
                nexusArtifactUploader(
                    nexusVersion: 'nexus3',
                    protocol: 'http',
                    nexusUrl: '18.61.85.39:8081',
                    repository: 'maven-releases',
                    credentialsId: 'nexus-credentials',
                    groupId: 'com.example',
                    version: "${BUILD_NUMBER}.0",
                    artifacts: [
                        [
                            artifactId: 'student-management',
                            classifier: '',
                            file: 'target/student-management.war',
                            type: 'war'
                ]
            ]
        )
     }
        }
    }
}