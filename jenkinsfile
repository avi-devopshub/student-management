pipeline{
	agent{
		label 'worker'
	}
	tools{
		maven 'maven'
		jdk 'jdk-17'
	}
	stages{
		stage('checkout'){
			steps{
				git 'https://github.com/avi-devopshub/student-management.git'
			}
			post{
				success{
					echo "checkout has been completed"
				}
			}
		}
		stage('mvn-build'){
			steps{
				
				sh '''
				   java --verion
				   mvn --version
				   mvn clean package
				   '''
			}
			post{
				success{
					archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
				}
			}
		}
	}
}