pipeline{
	agent{
		label 'worker'
	}
	tools{
		maven 'maven'
	}
	environment{
		my_creds = credentials('aws-cred')
	}
	stages{
		stage('mvn-build'){
			steps{
				sh '''
					mvn clean package -DskipTests
				'''
				}
			post{
				success{
					archiveArtifacts artifacts: '**/target/*.war' , fingerprint: true
				}
			}
		}
		stage('artifacts-to-s3'){
			steps{
				sh 'aws s3 cp target/*.war s3://artifactory-554663574879-ap-south-1-an/new-artifacts/student.war'
			}
		}
		stage('sonarqube-analysis'){
			steps{
				withSonarQubeEnv{
					sh 'mvn sonar:sonar'
				}
			}
		}
		stage('quality-gate'){
			steps{
				timeout(time: 5, unit 'MINUTES'){
					waitForQualityGate, abortPipeline: true
				}
			}
		}
		
	}
	
}